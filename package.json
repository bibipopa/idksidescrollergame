{
  "name": "rift-raid",
  "version": "1.0.0",
  "private": true,
  "description": "Browser-based multiplayer soulslike roguelite with 50 boss stages for 1-4 players",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "node --check server.js && node --check public/game.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.1.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.1"
  }
}
